# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic → console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model
ANTHROPIC_MODEL=claude-sonnet-5-5

# Any random string. Protects the one-time demo seeding endpoint (/api/seed?secret=...)
SEED_SECRET=change-me

# Your public URL (used for OAuth redirects and Stripe return links)
NEXT_PUBLIC_SITE_URL=https://hirekit-ashen.vercel.app

# ── Payments (Stripe → Developers → API keys / Webhooks) ──────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: "true" once Stripe Tax is switched on in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false

# ── Calendar & video integrations ─────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra → App registrations → Certificates & secrets
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Zoom App Marketplace → General app (OAuth)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional: separate key for encrypting stored calendar tokens
INTEGRATIONS_SECRET=
